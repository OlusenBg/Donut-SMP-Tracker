# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already gitignored.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
# Find it at: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=

# Supabase service_role secret key (NOT the anon/publishable key). This
# bypasses row-level security, so it must stay server-only — never prefix
# it with NEXT_PUBLIC_ or reference it from client components.
# Find it at: Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If set, /api/cron/tick requires this as a Bearer token, which
# is how Vercel authenticates its own cron requests to your deployment.
# Leave unset for local dev. See https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
